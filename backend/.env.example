# PostgreSQL — đổi user, password, host, port, tên DB cho đúng môi trường
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/DATN?schema=public"

PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# JWT — dùng chuỗi dài, ngẫu nhiên trên môi trường thật (không commit giá trị thật vào repo công khai)
JWT_SECRET="change-me-to-a-long-random-string-in-production"
# Thời hạn access token (giây), mặc định 7 ngày nếu bỏ trống
JWT_EXPIRES_SEC=604800

# Email đăng ký trùng giá trị này sẽ được gán role ADMIN (để trống = không auto-admin)
ADMIN_EMAIL=

# Chấm điểm bài viết TOPIK II bằng Gemini (để trống = bỏ qua, câu viết giữ trạng thái "chờ chấm")
GEMINI_API_KEY=
# Model Gemini dùng để chấm (mặc định gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud TTS Neural2 — tổng hợp giọng đọc NPC phía Server
# Lấy API Key tại: https://console.cloud.google.com/apis/credentials
# Cần bật API: Cloud Text-to-Speech API
GCP_TTS_API_KEY=

# OpenAI Whisper — nhận diện giọng nói (STT) chính xác cao
# Lấy API Key tại: https://platform.openai.com/api-keys
# Nếu để trống, hệ thống sẽ dùng Gemini audio làm fallback STT
OPENAI_API_KEY=
