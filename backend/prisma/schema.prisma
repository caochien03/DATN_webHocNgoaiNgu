generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  avatarUrl    String?
  avatarFrame  String?  @default("DEFAULT")
  bio          String?
  targetGoal   String?
  currentLevel String?
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  decks        Deck[]
  pathProgress UserPathProgress[]
  quizAttempts     QuizAttempt[]
  topikAttempts    TopikExamAttempt[]
  toeicAttempts    ToeicExamAttempt[]
  speakingSessions  SpeakingSession[]
  goalSetting       UserGoalSetting?
  dailyProgress     UserDailyProgress[]
  learningLanguages UserLearningLanguage[]
  groupMembers      StudyGroupMember[]
  groupActivities   GroupActivity[]
  groupCards        GroupCard[]
  pushSubscriptions PushSubscription[]
}

/// Ngôn ngữ user đang học (có thể học nhiều ngôn ngữ song song).
model UserLearningLanguage {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  languageCode String
  isActive     Boolean  @default(false)
  addedAt      DateTime @default(now())

  @@unique([userId, languageCode])
  @@index([userId])
}

model UserGoalSetting {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCardTarget Int      @default(20)
  timezone        String   @default("Asia/Ho_Chi_Minh")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserDailyProgress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  languageCode  String   @default("ko")
  reviewedCards Int      @default(0)
  quizAttempts  Int      @default(0)
  goalTarget    Int      @default(20)
  goalAchieved  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, date, languageCode])
  @@index([userId, date])
  @@index([userId, languageCode, date])
}

model Deck {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  languageCode  String            @default("ko")
  sourceTopicId String?
  sourceTopic   VocabularyTopic?  @relation(fields: [sourceTopicId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  cards         Card[]

  @@index([userId])
  @@index([userId, languageCode])
  @@index([sourceTopicId])
}

model VocabularyTopic {
  id           String           @id @default(cuid())
  title        String
  description  String?
  languageCode String           @default("ko")
  level        String?
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  words        VocabularyWord[]
  derivedDecks Deck[]
  pathSteps    LearningPathStep[]

  @@index([languageCode])
  @@index([level])
}

model VocabularyWord {
  id        String          @id @default(cuid())
  topicId   String
  topic     VocabularyTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  frontText String
  backText  String
  note      String?
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([topicId])
}

enum GrammarLevel {
  BEGINNER_1
  BEGINNER_2
  INTERMEDIATE_1
  INTERMEDIATE_2
  ADVANCED_1
  ADVANCED_2
}

model GrammarLesson {
  id           String            @id @default(cuid())
  level        GrammarLevel
  title        String
  summary      String?
  languageCode String            @default("ko")
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  vocabulary   LessonVocabulary[]
  points       GrammarPoint[]
  exercises    GrammarExercise[]
  pathSteps    LearningPathStep[]

  @@index([languageCode, level])
}

enum LearningPathStepType {
  TOPIC
  LESSON
}

model LearningPath {
  id          String              @id @default(cuid())
  title       String
  description String?
  languageCode String            @default("ko")
  level       String?
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  steps       LearningPathStep[]
  progress    UserPathProgress[]

  @@index([languageCode])
  @@index([level])
}

model LearningPathStep {
  id        String               @id @default(cuid())
  pathId    String
  path      LearningPath         @relation(fields: [pathId], references: [id], onDelete: Cascade)
  type      LearningPathStepType
  title     String
  summary   String?
  topicId   String?
  topic     VocabularyTopic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)
  lessonId  String?
  lesson    GrammarLesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  sortOrder Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([pathId])
  @@index([topicId])
  @@index([lessonId])
}

model UserPathProgress {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pathId            String
  path              LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  completedStepIds  String[]     @default([])
  startedAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([userId, pathId])
  @@index([userId])
  @@index([pathId])
}

model LessonVocabulary {
  id        String        @id @default(cuid())
  lessonId  String
  lesson    GrammarLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  frontText String
  backText  String
  note      String?
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([lessonId])
}

model GrammarPoint {
  id          String        @id @default(cuid())
  lessonId    String
  lesson      GrammarLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title       String
  meaning     String?
  structure   String?
  example     String?
  translation String?
  note        String?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([lessonId])
}

model GrammarExercise {
  id           String        @id @default(cuid())
  lessonId     String
  lesson       GrammarLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  prompt       String
  options      String[]
  correctIndex Int
  explanation  String?
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([lessonId])
}

model Card {
  id             String    @id @default(cuid())
  deckId         String
  deck           Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
  frontText      String
  backText       String
  note           String?
  sortOrder      Int       @default(0)
  correctCount   Int       @default(0)
  wrongCount     Int       @default(0)
  streak         Int       @default(0)
  lastResult     Boolean?
  lastReviewedAt DateTime?
  nextReviewAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([deckId])
  @@index([nextReviewAt])
}

enum QuizSourceType {
  DECK
  TOPIC
  LESSON
  PATH
}

model QuizAttempt {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType     QuizSourceType
  sourceId       String
  sourceTitle    String
  languageCode   String         @default("ko")
  totalQuestions Int
  correctAnswers Int
  scorePercent   Int
  createdAt      DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([userId, languageCode, createdAt])
  @@index([sourceType, sourceId])
}

enum TopikTier {
  TOPIK_I
  TOPIK_II
}

enum TopikSection {
  LISTENING
  READING
  WRITING
}

enum TopikAttemptMode {
  FULL_EXAM
  PRACTICE
}

/// Dạng bài theo khoảng số câu trong đề TOPIK (vd. nghe TOPIK I câu 4–8).
model TopikQuestionFormat {
  id          String       @id @default(cuid())
  tier        TopikTier
  section     TopikSection
  fromNo      Int
  toNo        Int
  title       String
  titleKo     String?
  description String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tier, section, fromNo, toNo])
  @@index([tier, section, sortOrder])
}

enum TopikQuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  ESSAY
}

/// Câu hỏi thuộc đề TOPIK — questionNo = số câu trong phần (nghe 1–30, đọc 1–40, viết 1–4).
model TopikQuestion {
  id           String              @id @default(cuid())
  tier         TopikTier
  section      TopikSection
  questionNo   Int
  questionType TopikQuestionType   @default(MULTIPLE_CHOICE)
  prompt       String
  passage      String?
  options      String[]
  correctIndex Int
  explanation  String?
  audioUrl     String?
  /// Ảnh đề bài / đoạn văn (bảng, thông báo…) — URL public.
  imageUrl     String?
  /// URL ảnh từng đáp án (câu chọn hình), index khớp `options`.
  optionImageUrls String[]         @default([])
  /// Nhóm cặp câu (vd. nghe 25–26): cùng bundleId → hiển thị chung 1 trang + audio.
  bundleId     String?
  /// Đáp án mẫu (câu viết đơn / luận) — không trả về API làm bài.
  modelAnswer  String?
  /// Ý nhỏ trong câu viết (vd. 51–52: ㉠, ㉡). JSON: [{ label, modelAnswer?, maxScore? }]
  writingParts Json?
  minChars     Int?
  maxChars     Int?
  /// Điểm tối đa câu viết (vd. 10, 30, 50).
  maxScore     Int?
  /// Rubric chấm (JSON) — không trả về API làm bài.
  rubric       Json?
  points       Int                 @default(2)
  isPublished  Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  examSlots    TopikExamQuestion[]

  @@index([tier, section, questionNo])
  @@index([isPublished])
  @@index([bundleId])
  @@index([questionType])
}

model TopikExam {
  id              String              @id @default(cuid())
  title           String
  description     String?
  tier            TopikTier
  durationMinutes Int                 @default(100)
  isPublished     Boolean             @default(true)
  sortOrder       Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  questions       TopikExamQuestion[]
  attempts        TopikExamAttempt[]

  @@index([tier, isPublished])
}

model TopikExamQuestion {
  id         String        @id @default(cuid())
  examId     String
  exam       TopikExam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId String
  question   TopikQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sortOrder  Int

  @@unique([examId, questionId])
  @@unique([examId, sortOrder])
  @@index([examId])
}

model TopikExamAttempt {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode           TopikAttemptMode
  examId         String?
  exam           TopikExam?       @relation(fields: [examId], references: [id], onDelete: SetNull)
  tier           TopikTier
  section        TopikSection?
  formatFromNo   Int?
  formatToNo     Int?
  /// Snapshot câu đã random khi bắt đầu thi thử (giữ thứ tự làm bài).
  questionIds    String[]         @default([])
  answers        Json
  correctCount   Int              @default(0)
  totalQuestions Int              @default(0)
  scorePercent   Int              @default(0)
  startedAt      DateTime         @default(now())
  finishedAt     DateTime?

  @@index([userId, finishedAt])
  @@index([examId])
}

enum ToeicTier {
  TOEIC_LR
}

enum ToeicSection {
  LISTENING
  READING
}

enum ToeicAttemptMode {
  FULL_EXAM
  PRACTICE
}

/// Dạng bài TOEIC LR theo Part (1–7) và khoảng số câu trong phần.
model ToeicQuestionFormat {
  id          String       @id @default(cuid())
  tier        ToeicTier    @default(TOEIC_LR)
  section     ToeicSection
  part        Int
  fromNo      Int
  toNo        Int
  title       String
  titleEn     String?
  description String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tier, section, fromNo, toNo])
  @@index([tier, section, sortOrder])
}

/// Câu hỏi TOEIC — questionNo trong phần (nghe 1–100, đọc 1–100).
model ToeicQuestion {
  id              String              @id @default(cuid())
  tier            ToeicTier           @default(TOEIC_LR)
  section         ToeicSection
  questionNo      Int
  prompt          String
  passage         String?
  options         String[]
  correctIndex    Int
  explanation     String?
  audioUrl        String?
  imageUrl        String?
  optionImageUrls String[]            @default([])
  bundleId        String?
  points          Int                 @default(1)
  isPublished     Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  examSlots       ToeicExamQuestion[]

  @@index([tier, section, questionNo])
  @@index([isPublished])
  @@index([bundleId])
}

model ToeicExam {
  id              String              @id @default(cuid())
  title           String
  description     String?
  tier            ToeicTier           @default(TOEIC_LR)
  durationMinutes Int                 @default(120)
  isPublished     Boolean             @default(true)
  sortOrder       Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  questions       ToeicExamQuestion[]
  attempts        ToeicExamAttempt[]

  @@index([tier, isPublished])
}

model ToeicExamQuestion {
  id         String        @id @default(cuid())
  examId     String
  exam       ToeicExam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId String
  question   ToeicQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sortOrder  Int

  @@unique([examId, questionId])
  @@unique([examId, sortOrder])
  @@index([examId])
}

model ToeicExamAttempt {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode           ToeicAttemptMode
  examId         String?
  exam           ToeicExam?       @relation(fields: [examId], references: [id], onDelete: SetNull)
  tier           ToeicTier        @default(TOEIC_LR)
  section        ToeicSection?
  formatFromNo   Int?
  formatToNo     Int?
  questionIds    String[]         @default([])
  answers        Json
  correctCount   Int              @default(0)
  totalQuestions Int              @default(0)
  scorePercent   Int              @default(0)
  startedAt      DateTime         @default(now())
  finishedAt     DateTime?

  @@index([userId, finishedAt])
  @@index([examId])
}

/// Trình độ tự đánh giá khi bắt đầu phiên luyện nói.
enum SpeakingSelfLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SpeakingSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum SpeakingTurnSpeaker {
  USER
  NPC
}

/// Chủ đề khảo sát (ẩm thực, du lịch…) — dùng lọc tình huống.
model SpeakingTopic {
  id           String              @id @default(cuid())
  title        String
  titleNative  String?
  description  String?
  languageCode String              @default("ko")
  sortOrder    Int                 @default(0)
  isPublished  Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  situations   SpeakingSituation[]

  @@index([languageCode, isPublished, sortOrder])
}

/// Tình huống giao tiếp — đơn vị nội dung chính của module luyện nói.
model SpeakingSituation {
  id            String              @id @default(cuid())
  topicId       String?
  topic         SpeakingTopic?      @relation(fields: [topicId], references: [id], onDelete: SetNull)
  languageCode  String              @default("ko")
  title         String
  contextVi     String
  level         SpeakingSelfLevel
  userRoleVi    String
  npcRoleVi     String
  openingLine   String
  /// Mục tiêu giao tiếp: [{ key, labelVi, required }]
  goals         Json
  systemPrompt  String
  maxUserTurns  Int                 @default(5)
  sortOrder     Int                 @default(0)
  isPublished   Boolean             @default(true)
  testScript    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  sessions      SpeakingSession[]

  @@index([topicId])
  @@index([languageCode, level, isPublished])
  @@index([isPublished, sortOrder])
}

/// Một lần user luyện hoàn chỉnh một tình huống.
model SpeakingSession {
  id               String                @id @default(cuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  situationId      String
  situation        SpeakingSituation     @relation(fields: [situationId], references: [id], onDelete: Cascade)
  languageCode     String                @default("ko")
  status           SpeakingSessionStatus @default(IN_PROGRESS)
  selectedTopicIds String[]              @default([])
  selfLevel        SpeakingSelfLevel
  /// Runtime: { party_size: "4", date_time: "내일 7시" }
  filledGoals      Json                  @default("{}")
  overallScore     Float?
  estimatedLevel   String?
  summaryFeedback  String?
  goalsCompleted   Int?
  goalsTotal       Int?
  startedAt        DateTime              @default(now())
  completedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  turns            SpeakingTurn[]

  @@index([userId, createdAt])
  @@index([situationId])
  @@index([status])
}

/// Một lượt hội thoại (USER hoặc NPC) trong phiên.
model SpeakingTurn {
  id           String              @id @default(cuid())
  sessionId    String
  session      SpeakingSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  orderIndex   Int
  speaker      SpeakingTurnSpeaker
  text         String
  /// Chấm lượt USER: { task, grammar, vocabulary, coherence, score, feedback }
  grading      Json?
  durationSecs Int?
  createdAt    DateTime            @default(now())

  @@unique([sessionId, orderIndex])
  @@index([sessionId])
}

/// Nhóm học tập (Lingora Squad)
model StudyGroup {
  id           String             @id @default(cuid())
  name         String
  description  String?
  avatarUrl    String?
  languageCode String             @default("ko")
  inviteCode   String             @unique
  targetPathId String?
  maxMembers   Int                @default(8)
  createdById  String
  squadStreak  Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  members      StudyGroupMember[]
  activities   GroupActivity[]
  cards        GroupCard[]

  @@index([inviteCode])
  @@index([languageCode])
}

model StudyGroupMember {
  id       String    @id @default(cuid())
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  weeklyXp Int       @default(0)
  totalXp  Int       @default(0)
  joinedAt DateTime  @default(now())

  group    StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

enum GroupRole {
  LEADER
  ADMIN
  MEMBER
}

model GroupActivity {
  id        String       @id @default(cuid())
  groupId   String
  userId    String
  type      ActivityType
  metadata  Json?
  createdAt DateTime     @default(now())

  group     StudyGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([userId])
}

enum ActivityType {
  COMPLETED_DAILY_GOAL
  COMPLETED_QUIZ
  COMPLETED_LESSON
  ADDED_CARD
  JOINED_GROUP
  NUDGE
}

model GroupCard {
  id          String     @id @default(cuid())
  groupId     String
  createdById String
  term        String
  meaning     String
  example     String?
  createdAt   DateTime   @default(now())

  group       StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([createdById])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


